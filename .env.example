# Copia este archivo como .env y llena tus datos.
# Si dejas BDV_CLAVE vacío, el programa te la pedirá al arrancar (más seguro).
BDV_USUARIO=
BDV_CLAVE=
# Últimos 4 dígitos de la cuenta donde recibes los pagos
BDV_CUENTA=
# "si" para que el navegador del banco no se vea (cuando ya confíes en que funciona)
BDV_OCULTAR_NAVEGADOR=no
# Minutos que la sesión queda abierta después de la última consulta (luego se cierra sola)
BDV_SESION_MINUTOS=10
# Cada cuántos segundos el programa "toca" el banco para que no cierre la sesión
BDV_PING_SEGUNDOS=90

# --- Red local (cajeras en otras computadoras) ---
# "si" para que las cajeras entren desde otras computadoras de la red.
# "no" = solo funciona en esta computadora.
BDV_ESCUCHAR_RED=no
# Puerto de la página (las cajeras entran a http://IP-de-esta-PC:PUERTO)
BDV_PUERTO=5000

# --- Diagnóstico ---
# "si" para guardar una captura y el contenido de la tabla en la carpeta diagnostico/
# en CADA verificación (siempre se guarda cuando el resultado es "No encontrado").
BDV_DEPURAR=no
